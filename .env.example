# 공공데이터포털(data.go.kr) > 기상청_단기예보 조회서비스 > 일반 인증키(Decoding)
KMA_SERVICE_KEY=your_decoding_service_key_here
# Supabase > Project Settings > API. service_role 키는 서버 전용 (브라우저/깃에 노출 금지)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Google AI Studio(aistudio.google.com) > Get API key. 서버 전용 — 브라우저/깃에 노출 금지
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# PORT=3000
